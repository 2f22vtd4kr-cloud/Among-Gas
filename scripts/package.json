    "test:browser-smoke": "node ./browser-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.vector-collision.json --noEmit && tsc -p tsconfig.collision-preview.json --noEmit",
    "test:character-atlas": "tsx ./test-character-atlas.ts",
    "test:character-atlas-browser": "tsx ./test-character-atlas-browser.mjs",
    "test:telegram-start-param": "tsx ./test-telegram-start-param.ts",
    "test:vector-collision": "tsx ./src/testVectorCollision.ts && tsx ./src/testRasterVectorParity.ts && tsx ./test-collision-release-readiness.ts && tsx ./test-disconnected-region-review.ts",
    "test:vector-collision-editor-api": "node ./test-vector-collision-editor-api.mjs",
    "build:map-tiles": "tsx src/buildMapTiles.ts",
    "test:map-tiles": "tsx src/testMapTiles.ts",
    "test:map-tiles-browser": "node ./test-map-tiles-browser.mjs",
    "test:production-world": "pnpm run build:collision && pnpm run test:vector-runtime-isolation",
    "test:vector-runtime-integration": "node ./test-vector-runtime-isolation.mjs",
    "test:vector-runtime-isolation": "node ./test-vector-runtime-isolation.mjs",
    "verify:zone-source-evidence": "node ./verify-zone-review-source-evidence.mjs",
    "verify:asset-provenance": "node ./verify-asset-provenance-inventory.mjs",
    "test:map-renderer": "tsc -p tsconfig.map-renderer-test.json --noEmit && tsx ../artifacts/telegram-game/src/game/mapBaseLayer.test.ts && tsx ../artifacts/telegram-game/src/game/mapMarkerRenderer.test.ts && tsx ../artifacts/telegram-game/src/game/mapWorldDetailsRenderer.test.ts && tsx ../artifacts/telegram-game/src/game/mapRemotePlayerRenderer.test.ts && tsx ../artifacts/telegram-game/src/game/mapLocalPlayerRenderer.test.ts && tsx ../artifacts/telegram-game/src/game/mapPlayerCanvasPosition.test.ts && tsx ../artifacts/telegram-game/src/game/mapVisionRenderer.test.ts && tsx ../artifacts/telegram-game/src/game/mapVisionPolicy.test.ts && tsx ../artifacts/telegram-game/src/game/visibility.test.ts && tsx src/testTiledMapRenderer.ts",
    "test:minigame-registry": "tsx --tsconfig ./tsconfig.minigame.json ../artifacts/telegram-game/src/components/minigames/testMinigameRegistry.tsx",
    "test:map-camera": "tsx ../artifacts/telegram-game/src/game/mapCamera.test.ts",
    "test:remote-player-animation": "tsx ../artifacts/telegram-game/src/game/remotePlayerAnimation.test.ts",
    "test:game-action-state": "tsx ../artifacts/telegram-game/src/game/gameActionState.test.ts && tsx ../artifacts/telegram-game/src/components/GameActionBar.test.tsx && tsx ../artifacts/telegram-game/src/context/GameContext.resume.test.ts",
    "test:game-input": "tsx ../artifacts/telegram-game/src/game/gameInput.test.ts",
    "build:character-atlas": "tsx ./src/buildCharacterAtlas.ts",
    "test:admin-table": "pnpm --filter @workspace/telegram-game exec tsx src/components/GameAdminTable.test.tsx",
    "test:vent-overlay": "pnpm --filter @workspace/telegram-game exec tsx src/components/GameVentOverlay.test.tsx",
    "test:emergency-button": "pnpm --filter @workspace/telegram-game exec tsx src/components/GameEmergencyMeetingButton.test.tsx",
    "test:meeting-overlay": "pnpm --filter @workspace/telegram-game exec tsx src/components/GameMeetingOverlay.test.tsx",
    "test:game-minimap": "pnpm --filter @workspace/telegram-game exec tsx src/components/GameMiniMapOverlay.test.tsx",
    "measure:raster-vector-parity": "tsx ./src/measureRasterVectorParity.ts",
    "verify:groq-live": "tsx ./src/verifyLiveGroqProvider.ts",
    "test:groq-evidence-output": "tsx ./src/testSafeEvidenceOutput.ts"
