  "devDependencies": {
    "@types/node": "catalog:",
    "playwright-core": "^1.64.1",
    "tsx": "catalog:"
  },
  "dependencies": {
    "@workspace/shared": "workspace:*",
    "sharp": "^0.35.5"
  }
}
