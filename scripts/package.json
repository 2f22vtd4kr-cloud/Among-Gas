{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "build:collision": "tsx ./src/buildCollisionDocument.ts",
    "test:pathfinding": "tsx ./src/testPathfinding.ts",
    "test:map-image-transform": "tsx ./src/testMapImageTransform.ts",
    "test:character-geometry": "tsx ../artifacts/telegram-game/src/game/characterSprites.test.ts && tsx ../artifacts/telegram-game/src/game/characterSpriteRenderer.test.ts && tsx ../artifacts/telegram-game/src/game/characterAnimation.test.ts && tsx ../artifacts/telegram-game/src/game/characterGhostMotion.test.ts && tsx ./test-character-atlas.ts",
    "test:browser-smoke": "node ./browser-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.vector-collision.json --noEmit && tsc -p tsconfig.collision-preview.json --noEmit",
    "test:character-atlas": "tsx ./test-character-atlas.ts",
    "test:telegram-start-param": "tsx ./test-telegram-start-param.ts",
    "test:vector-collision": "tsx ./src/testVectorCollision.ts",
    "test:vector-collision-editor-api": "node ./test-vector-collision-editor-api.mjs",
    "build:map-tiles": "tsx src/buildMapTiles.ts",
    "test:map-tiles": "tsx src/testMapTiles.ts",
    "test:map-tiles-browser": "node ./test-map-tiles-browser.mjs",
    "test:production-world": "pnpm run build:collision && pnpm run test:vector-runtime-isolation",
    "test:vector-runtime-integration": "node ./test-vector-runtime-isolation.mjs",
    "test:vector-runtime-isolation": "node ./test-vector-runtime-isolation.mjs",
    "test:map-renderer": "tsc -p tsconfig.map-renderer-test.json --noEmit && tsx ../artifacts/telegram-game/src/game/mapBaseLayer.test.ts && tsx ../artifacts/telegram-game/src/game/mapMarkerRenderer.test.ts && tsx ../artifacts/telegram-game/src/game/mapWorldDetailsRenderer.test.ts && tsx ../artifacts/telegram-game/src/game/mapRemotePlayerRenderer.test.ts && tsx ../artifacts/telegram-game/src/game/mapLocalPlayerRenderer.test.ts && tsx ../artifacts/telegram-game/src/game/mapVisionRenderer.test.ts && tsx src/testTiledMapRenderer.ts",
    "test:minigame-registry": "tsx --tsconfig ./tsconfig.minigame.json ../artifacts/telegram-game/src/components/minigames/testMinigameRegistry.tsx",
    "test:map-camera": "tsx ../artifacts/telegram-game/src/game/mapCamera.test.ts",
    "test:remote-player-animation": "tsx ../artifacts/telegram-game/src/game/remotePlayerAnimation.test.ts",
    "test:game-action-state": "tsx ../artifacts/telegram-game/src/game/gameActionState.test.ts",
    "test:game-input": "tsx ../artifacts/telegram-game/src/game/gameInput.test.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "playwright-core": "^1.64.1",
    "tsx": "catalog:"
  },
  "dependencies": {
    "@workspace/shared": "workspace:*",
    "sharp": "^0.35.3"
  }
}
