# Run the Vite frontend and API together for the Replit preview. Vite proxies
# same-origin /api HTTP requests and WebSocket upgrades to the private API port.
run = "bash scripts/replit-dev.sh"

modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["bash", "-lc", "env -u VITE_WS_URL PORT=5173 BASE_PATH=/ pnpm run build"]
run = ["pnpm", "--filter", "@workspace/api-server", "run", "start"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
